# Copy to .env and fill in (web UI can override runtime settings in data/settings.json)

# Web admin (local only — bind 127.0.0.1 by default)
WEB_PORT=3847
WEB_ADMIN_SECRET=change-me-long-random

# Defaults until configured in web UI
TELEGRAM_BOT_TOKEN=
CURSOR_API_KEY=
# URL git-репозитория rm_bot для заявок /feedback (без этого агент не стартует)
CURSOR_REPO_URL=
CURSOR_GIT_REF=main
ADMIN_TELEGRAM_ID=233097427

# Redmine default project (per-account tokens in DB)
REDMINE_BASE_URL=https://track.grandproject.ru
